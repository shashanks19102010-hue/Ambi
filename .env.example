# Required for cloud chat
GROQ_API_KEY=

# Optional vision override; defaults to the supported Ambi vision model.
AMBI_VISION_MODEL=qwen/qwen3.6-27b

# Keep web research off by default. Set to 1 explicitly when you want server-side research.
AMBI_WEB_SEARCH_ENABLED=0
TAVILY_API_KEY=

# Image and video generation run client-side through Puter.js.
# No Pixazo or media-provider API keys are required.
