OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.0
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
OPENROUTER_TTS_VOICE=alloy
# Legacy OpenAI image variables are kept only for compatibility.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
