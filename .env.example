# Required for cloud chat
GROQ_API_KEY=

# Optional vision override
AMBI_VISION_MODEL=qwen/qwen3.6-27b

# Web research is fail-closed and off by default
AMBI_WEB_SEARCH_ENABLED=0
TAVILY_API_KEY=

# Pexels stock photo/video search (server-side only)
PEXELS_API_KEY=

# Image/video generation (server-side only)
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=zimage
POLLINATIONS_VIDEO_MODEL=veo

# Shared rate limiting (recommended for Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional explicit production origin allowlist
AMBI_ALLOWED_ORIGIN=
