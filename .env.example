GROQ_API_KEY=
AI_GATEWAY_API_KEY=
AMBI_CLOUD_MODEL=openai/gpt-oss-120b
AMBI_VISION_MODEL=qwen/qwen3.6-27b
AMBI_WEB_SEARCH_ENABLED=1
TAVILY_API_KEY=
# OpenRouter powers optional image, video, and speech generation.
# Never commit real secrets to this file or the repository.
OPENROUTER_API_KEY=
