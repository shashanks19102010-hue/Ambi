# Server-side web search provider
TAVILY_API_KEY=
AMBI_WEB_SEARCH_ENABLED=0

# Server-side Groq Cloud AI
# Use a Groq API key. Never expose this value to the browser.
GROQ_API_KEY=

# Backward-compatible alias: Ambi also accepts this variable as a Groq key.
AI_GATEWAY_API_KEY=

# Default Groq model. Users can select another allowlisted model in Ambi Settings.
AMBI_CLOUD_MODEL=openai/gpt-oss-120b
